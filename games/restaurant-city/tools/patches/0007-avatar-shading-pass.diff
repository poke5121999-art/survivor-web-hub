+   import away3d.core.render.AbstractRenderSession;
+   import away3d.materials.WhiteShadingBitmapMaterial;
+   import flash.display.BitmapData;
+
+   // Avatar skin/clothes texture, plus the face's shading into AvatarLighting.shadeLayer when
+   // set. Extends WhiteShadingBitmapMaterial for its per-face light values.
+   public class ShadedBitmapMaterial extends WhiteShadingBitmapMaterial
