+++ b/scripts/com/playfish/games/cooking/AvatarLighting.as
@@ -0,0 +1,37 @@
+package com.playfish.games.cooking
+{
+   // Shading for cached avatar frames (IsoCacher). Away3D's Phong materials stack blend-mode
+   // layers that Ruffle drops when drawing to a BitmapData, so avatars came out unlit; the
+   // original game shows soft light and shade on hair, skin and clothes.
+   public class AvatarLighting
+   {
+
+      // GameWorld.light has ambient 0.5 and diffuse 1, so a face's ambient + diffuse sum runs
+      // from 0.5 (facing away from the light) to 1.5 (facing it).
+      public static const LUM_DARK:Number = 0.5;
+
+      public static const LUM_LIT:Number = 1.3;
+
+      public static const MAX_SHADE:Number = 0.35;
+
+      // Shadow colour: a warm brown reads as skin in shade, black reads as grime on pale skin.
+      public static const SHADE_TINT:uint = 0x6E3424;
+
+      // While true, avatar materials draw their shading (white, darkened toward SHADE_TINT by
+      // shadeAlpha) instead of their texture; IsoCacher sets it for its shading pass.
+      public static var shadePass:Boolean = false;
+
+      public function AvatarLighting()
+      {
+         super();
+      }
+
+      // How far to darken a face, from its ambient + diffuse light (CenterLightingMaterial.renderTri).
+      public static function shadeAlpha(param1:Number, param2:Number, param3:Number, param4:Number, param5:Number, param6:Number) : Number
+      {
+         var _loc7_:Number = (param1 + param2 + param3 + param4 + param5 + param6) / 3;
+         var _loc8_:Number = (_loc7_ - LUM_DARK) / (LUM_LIT - LUM_DARK);
+         return MAX_SHADE * (1 - Math.max(0,Math.min(1,_loc8_)));
+      }
+   }
+}
